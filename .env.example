# ─────────── ฐานข้อมูล (Railway Postgres) ───────────
# Railway > Postgres service > Variables > DATABASE_URL
# ตอนต่อจากเครื่องตัวเองให้ใช้ค่า public (มี proxy.rlwy.net) ไม่ใช่ค่า internal
DATABASE_URL="postgresql://postgres:password@localhost:5432/alexan?schema=public"

# ─────────── Auth.js ───────────
# สร้างด้วย: npx auth secret   (หรือ openssl rand -base64 32)
AUTH_SECRET=""
# URL จริงของเว็บตอน deploy เช่น https://alexanproduction.com
AUTH_URL="http://localhost:3000"

# ─────────── Cloudflare R2 (เก็บรูป/ไฟล์) ───────────
# Cloudflare Dashboard > R2 > Manage API Tokens
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="alexan-media"
# โดเมนสาธารณะของ bucket เช่น https://media.alexanproduction.com
R2_PUBLIC_URL=""

# ─────────── Resend (อีเมลแจ้งเตือน lead / ส่งใบเสนอราคา) ───────────
RESEND_API_KEY=""
# ต้องเป็นโดเมนที่ verify แล้วใน Resend
MAIL_FROM="Alexan Production <no-reply@alexanproduction.com>"
# ปลายทางที่จะรับแจ้งเตือนคำขอใหม่
MAIL_TO="hello@alexanproduction.com"

# ─────────── สาธารณะ (ฝังเข้าไปใน bundle ตอน build) ───────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# ว่างไว้ = ไม่โหลดสคริปต์ Google Analytics เลย
NEXT_PUBLIC_GA_ID=""

# ─────────── ผู้ดูแลคนแรก (ใช้ตอน npm run db:seed เท่านั้น) ───────────
SEED_ADMIN_EMAIL="admin@alexanproduction.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Alexan Admin"
